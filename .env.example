# Lux AI — Ortam Değişkenleri
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun. `.env` git'e girmez.

# --- Yerel modeller kökü (Ollama / Whisper / Piper / Coqui / HuggingFace) ---
# Windows: D:\LuxAI_Models   |   Linux/macOS: /home/<user>/lux_models
LUX_MODELS_DIR=

# --- Python yorumlayıcı (voice_service.py için; sürüm 3.12 önerilir) ---
# Windows: C:\Users\<user>\AppData\Local\Programs\Python\Python312\python.exe
# Linux/macOS: /usr/bin/python3.12
LUX_PYTHON=

# --- Yerel Ollama ---
OLLAMA_MODELS=

# --- Bulut sağlayıcı anahtarları (opsiyonel; uygulama içi Ayarlar ekranından da girilebilir) ---
# Anahtarlar app tarafında Electron safeStorage ile şifrelenerek saklanır.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

{
  "printWidth": 140,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "vueIndentScriptAndStyle": false,
  "trailingComma": "none",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "overrides": [
    {
      "files": ["main.js", "src/preload.js", "src/logger.js", "src/main/**/*.js", "scripts/**/*.js", "eslint.config.js"],
      "options": { "singleQuote": true, "printWidth": 120 }
    }
  ]
}
